# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini AI Receipt Scanner
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Akun Supabase pemilik: QFine tanpa halaman login, server masuk otomatis dengan akun ini
QFINE_EMAIL=you@example.com
QFINE_PASSWORD=your-supabase-account-password

# Pintasan iPhone (Shortcuts): token rahasia untuk POST /api/shortcut/scan (minimal 16 karakter acak)
QFINE_SHORTCUT_TOKEN=ganti-dengan-token-acak-panjang
